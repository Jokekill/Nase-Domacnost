# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://domacnost:domacnost_dev@127.0.0.1:5432/domacnost
POSTGRES_PASSWORD=domacnost_dev

# Feature flags
PUBLIC_SHARING_ENABLED=false

# Set to "true" only for local http://localhost development (drops __Host- cookie prefix)
DEV_INSECURE_COOKIES=true

# Photo uploads (Docker volume in production)
UPLOADS_DIR=./data/uploads

# --- Nasazení (docs/DEPLOY.md) ---------------------------------------------
# Obraz aplikace; prázdné = staví se lokálně jako nase-domacnost:local
# APP_IMAGE=ghcr.io/<uzivatel>/nase-domacnost:1.0.0
# Hostitelské adresáře pro fotky a zálohy (čte je i zálohovací sidecar)
# UPLOADS_HOST_DIR=/srv/domacnost/uploads
# BACKUPS_HOST_DIR=/srv/domacnost/backups
# Hodina denní zálohy (00-23)
# BACKUP_HOUR=03
